# ==============================================================================
# DocketRail Environment Configuration Template
# Baseline: November 2026 (See docs/build-dan-deploy.md Section 6)
# ==============================================================================

# Web Public Environment Variables (Browser & Server)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_key_here

# Web Server-Only Environment Variables (Never expose to client!)
SUPABASE_SECRET_KEY=sb_secret_service_key_here
DOCKETRAIL_PILOT_ENABLED=true
DOCKETRAIL_MAINNET_ENABLED=false

# Budget Limits (in micro-USD: 1 USD = 1,000,000 micro-USD)
DOCKETRAIL_TOTAL_BUDGET_MICRO_USD=1000000
DOCKETRAIL_SERVICE_BUDGET_MICRO_USD=600000
DOCKETRAIL_RUN_BUDGET_MICRO_USD=120000

# Runner Non-Secret Configuration
DOCKETRAIL_API_URL=http://localhost:3000
DOCKETRAIL_RUNNER_NAME=docketrail-runner-local
DOCKETRAIL_BUY_ACCOUNT=docketrail
